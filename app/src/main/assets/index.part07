="badge">PDF</span>':''}</span>`;$('songChecks').appendChild(l)});$('playlistModal').classList.add('open')}
$('newList').onclick=()=>{drawer.classList.remove('open');openPlaylistEditor()};$('cancelPlaylist').onclick=()=>$('playlistModal').classList.remove('open');
$('savePlaylist').onclick=()=>{const name=$('playlistName').value.trim();const ids=[...$('songChecks').querySelectorAll('input:checked')].map(x=>x.value);if(!name)return alert('Digite um nome para a lista.');if(!ids.length)return alert('Selecione pelo menos uma música.');const id=$('playlistModal').dataset.id;let p=data.playlists.find(x=>x.id===id);if(p){p.name=name;p.songIds=ids}else{p={id:'pl-'+uid(),name,songIds:ids};data.playlists.push(p)}saveData();$('playlistModal').classList.remove('open');activePlaylistId=p.id;localStorage.setItem('activePlaylistId',p.id);currentId=ids[0];render()};
function openLists(){$('playlists').innerHTML='';if(!data.playlists.length)$('playlists').innerHTML='<p class="small">Nenhuma lista criada ainda.</p>';data.playlists.forEach(p=>{const d=document.createElement('div');d.className='playlistItem';d.innerHTML=`<div style="flex:1"><strong>${escapeHtml(p.name)}</strong><div class="small">${p.songIds.length} música(s)</div></div><button data-a="open">Abrir</button><button data-a="edit">Editar</button><button data-a="del" class="danger">Excluir</button>`;d.querySelector('[data-a=open]').onclick=()=>{activePlaylistId=p.id;localStorage.setItem('activePlaylistId',p.id);currentId=p.songIds[0];$('listsModal').classList.remove('open');drawer.classList.remove('open');render()};d.querySelector('[data-a=edit]').onclick=()=>{$('listsModal').classList.remove('open');openPlaylistEditor(p)};d.querySelector('[data-a=del]').onclick=()=>{if(confirm(`Excluir a lista “${p.name}”?`)){data.playlists=data.playlists.filter(x=>x.id!==p.id);if(activePlaylistId===p.id){activePlaylistId='';localStorage.removeItem('activePlaylistId')}saveData();openLists();render()}};$('playlists').appendChild(d)});$('listsModal').classList.add('open')}
window.openLists=openLists;$('manageLists').onclick=()=>{drawer.classList.remove('open');openLists()};$('closeLists').onclick=()=>$('listsModal').classList.remove('open');$('createAnother').onclick=()=>{$('listsModal').classList.remove('open');openPlaylistEditor()};$('showAll').onclick=()=>{activePlaylistId='';localStorage.removeItem('activePlaylistId');drawer.classList.remove('open');render()};
render();
</script></body></html>