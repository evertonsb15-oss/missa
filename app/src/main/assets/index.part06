h.max(220,document.querySelector('.sheet').clientWidth-28),lines=s.content.split('\n');let size=max;ctx.font=`${size}px ${family}`;let w=0;for(const l of lines)w=Math.max(w,ctx.measureText(l||' ').width);if(w>available)size=Math.max(min,size*(available/w)*.98);document.documentElement.style.setProperty('--font',size.toFixed(2)+'px')}
function renderNav(){ensureCurrent();const seq=activeSequence();select.innerHTML='';seq.forEach((s,i)=>{const o=document.createElement('option');o.value=s.id;o.textContent=`${i+1}. ${s.title}`;select.appendChild(o)});list.innerHTML='';seq.forEach((s,i)=>{const b=document.createElement('button');b.className='songitem'+(s.id===currentId?' active':'');b.innerHTML=`${i+1}. ${escapeHtml(s.title)}${s.source==='pdf'?'<span class="badge">PDF</span>':''}`;b.onclick=()=>{currentId=s.id;render();drawer.classList.remove('open')};list.appendChild(b)});const p=data.playlists.find(x=>x.id===activePlaylistId);$('activeListInfo').innerHTML=p?`<div class="sectionlabel">Lista ativa</div><button class="songitem" onclick="openLists()">☷ ${escapeHtml(p.name)} <span class="small">(${seq.length})</span></button>`:''}
function render(){ensureCurrent();const s=currentSong(),seq=activeSequence(),idx=seq.findIndex(x=>x.id===s.id);title.textContent=s.title;counter.textContent=(activePlaylistId?'Lista • ':'')+`${idx+1} de ${seq.length}`;lyrics.textContent=s.content;select.value=s.id;localStorage.setItem('songId',s.id);renderNav();stage.scrollTo(0,0);requestAnimationFrame(fitText)}
function go(delta){const seq=activeSequence();let i=seq.findIndex(x=>x.id===currentId);i=(i+delta+seq.length)%seq.length;currentId=seq[i].id;render()}
function escapeHtml(s){return String(s||'').replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]))}
$('prev').onclick=()=>go(-1);$('next').onclick=()=>go(1);select.onchange=e=>{currentId=e.target.value;render()};$('menu').onclick=()=>drawer.classList.add('open');drawer.onclick=e=>{if(e.target===drawer)drawer.classList.remove('open')};$('minus').onclick=()=>{manualScale=Math.max(.7,manualScale-.1);localStorage.setItem('fontScale',manualScale);fitText()};$('plus').onclick=()=>{manualScale=Math.min(1.6,manualScale+.1);localStorage.setItem('fontScale',manualScale);fitText()};document.body.classList.toggle('dark',localStorage.getItem('dark')==='1');$('theme').onclick=()=>{document.body.classList.toggle('dark');localStorage.setItem('dark',document.body.classList.contains('dark')?'1':'0')};
let startX=0,startY=0;stage.addEventListener('touchstart',e=>{startX=e.changedTouches[0].clientX;startY=e.changedTouches[0].clientY},{passive:true});stage.addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-startX,dy=e.changedTouches[0].clientY-startY;if(Math.abs(dx)>70&&Math.abs(dx)>Math.abs(dy)*1.3)go(dx<0?1:-1)},{passive:true});window.addEventListener('resize',()=>requestAnimationFrame(fitText));
function openEditor(song){$('editorHeading').textContent=song?.source==='pdf'?'Revisar música importada':'Editar música';$('editTitle').value=song?.title||'';$('editContent').value=song?.content||'';$('editorModal').dataset.songId=song?.id||'';$('editorModal').classList.add('open')}
$('edit').onclick=()=>openEditor(currentSong());$('cancelEdit').onclick=()=>$('editorModal').classList.remove('open');
function shiftCurrentLine(n){const ta=$('editContent'),pos=ta.selectionStart,v=ta.value,start=v.lastIndexOf('\n',Math.max(0,pos-1))+1,end=v.indexOf('\n',pos);const e=end<0?v.length:end;let line=v.slice(start,e);if(n>0)line=' '.repeat(n)+line;else{let rm=Math.min(-n,(line.match(/^ */)||[''])[0].length);line=line.slice(rm)}ta.value=v.slice(0,start)+line+v.slice(e);ta.selectionStart=ta.selectionEnd=Math.min(start+Math.max(0,pos-start+n),start+line.length);ta.focus()}
$('left1').onclick=()=>shiftCurrentLine(-1);$('right1').onclick=()=>shiftCurrentLine(1);$('left4').onclick=()=>shiftCurrentLine(-4);$('right4').onclick=()=>shiftCurrentLine(4);
$('saveEdit').onclick=()=>{const id=$('editorModal').dataset.songId, song=data.songs.find(s=>s.id===id);if(!song)return; song.title=$('editTitle').value.trim()||'Sem título';song.content=$('editContent').value.replace(/\r/g,'');song.edited=true;saveData();$('editorModal').classList.remove('open');render()};
$('importPdf').onclick=()=>{drawer.classList.remove('open');if(window.Android&&Android.pickPdf)Android.pickPdf();else alert('A importação de PDF funciona no aplicativo Android. Nesta prévia, use o projeto instalado no celular.')};
window.onPdfImported=function(json){try{const payload=typeof json==='string'?JSON.parse(json):json;const pages=payload.pages||[];if(!pages.length){alert('Não foi possível extrair texto deste PDF. Se ele for apenas imagem/scan, será necessário OCR em uma versão futura.');return}const created=[];pages.forEach((text,i)=>{const clean=String(text||'').replace(/\r/g,'').trim();if(!clean)return;const first=(clean.split('\n').find(x=>x.trim())||payload.name||'Música').trim();const song={id:'pdf-'+uid(),title:(pages.length>1?`${first} — pág. ${i+1}`:first).slice(0,120),content:clean,source:'pdf',pdfName:payload.name||'PDF importado'};data.songs.push(song);created.push(song)});saveData();if(created.length){activePlaylistId='';localStorage.removeItem('activePlaylistId');currentId=created[0].id;render();openEditor(created[0]);alert(`${created.length} página(s) importada(s). Revise o texto e ajuste as cifras antes de salvar.`)}}catch(e){alert('Falha ao importar o PDF: '+e.message)}};
function openPlaylistEditor(existing){$('playlistHeading').textContent=existing?'Editar lista':'Criar lista personalizada';$('playlistName').value=existing?.name||'';$('playlistModal').dataset.id=existing?.id||'';const selected=new Set(existing?.songIds||[]);$('songChecks').innerHTML='';data.songs.forEach((s,i)=>{const l=document.createElement('label');l.className='check';l.innerHTML=`<input type="checkbox" value="${s.id}" ${selected.has(s.id)?'checked':''}><span>${i+1}. ${escapeHtml(s.title)} ${s.source==='pdf'?'<span class