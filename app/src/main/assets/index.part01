<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
<meta name="theme-color" content="#0C4A3C"/>
<title>Cânticos - Outubro Missionário</title>
<style>
:root{--bg:#f7f6f0;--card:#fff;--ink:#18201d;--muted:#68736e;--green:#0c4a3c;--gold:#b98a18;--line:#dfe5e1;--danger:#a83434;--font:20px}
*{box-sizing:border-box}html,body{margin:0;height:100%;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;overflow:hidden}body.dark{--bg:#111815;--card:#18211d;--ink:#f4f5f3;--muted:#aeb9b3;--line:#33423a;--green:#166b58;--gold:#e4bc54}.app{height:100dvh;display:grid;grid-template-rows:auto 1fr auto}header{background:var(--green);color:#fff;padding:max(10px,env(safe-area-inset-top)) 10px 10px;box-shadow:0 2px 10px #0002;z-index:5}.top{display:flex;align-items:center;gap:7px}.titlebox{min-width:0;flex:1}#songTitle{font-weight:800;font-size:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}#counter{font-size:12px;opacity:.82;margin-top:2px}button{border:0;border-radius:12px;background:#ffffff1f;color:inherit;min-width:42px;min-height:42px;font-size:17px;font-weight:750;cursor:pointer}button:active{transform:scale(.97)}main{overflow:auto;-webkit-overflow-scrolling:touch;padding:14px 12px 24px;touch-action:pan-y}.sheet{max-width:980px;margin:auto;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px 14px;box-shadow:0 3px 18px #0000000b;min-height:calc(100% - 4px)}pre{margin:0;white-space:pre;tab-size:4;font-family:"Roboto Mono","DejaVu Sans Mono",monospace;font-size:var(--font);line-height:1.55;letter-spacing:-.02em;overflow:visible;color:var(--ink)}footer{display:grid;grid-template-columns:1fr auto 1fr;gap:8px;padding:8px 10px max(8px,env(safe-area-inset-bottom));background:var(--card);border-top:1px solid var(--line)}.nav{background:var(--green);color:#fff;padding:0 12px;font-size:14px}#pageSelect{max-width:170px;border:1px solid var(--line);border-radius:12px;background:var(--bg);color:var(--ink);padding:0 8px;font-size:14px;font-weight:650}#prev{justify-self:start}#next{justify-self:end}.drawer{position:fixed;inset:0;z-index:20;display:none;background:#0007}.drawer.open{display:block}.panel{width:min(92vw,440px);height:100%;background:var(--card);color:var(--ink);padding:max(16px,env(safe-area-inset-top)) 12px 20px;overflow:auto;box-shadow:8px 0 30px #0004}.panel h2{margin:4px 8px 10px;font-size:20px}.toolbar{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:8px}.solid{background:var(--green)!important;color:white!important;padding:8px 10px;font-size:13px}.outline{background:transparent!important;color:var(--ink)!important;border:1px solid var(--line)!important;padding:8px 10px;font-size:13px}.danger{background:var(--danger)!important;color:white!important}.songitem{display:block;width:100%;text-align:left;background:transparent;color:var(--ink);border-bottom:1px solid var(--line);border-radius:8px;padding:11px 10px;font-size:14px;min-height:44px}.songitem.active{background:color-mix(in srgb,var(--green) 14%,transparent);font-weight:800}.sectionlabel{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-weight:800;margin:16px 10px 6px}.hint{text-align:center;color:var(--muted);font-size:11px;padding:5px 8px 0}.badge{display:inline-block;font-size:10px;padding:2px 6px;border-radius:99px;background:color-mix(in srgb,var(--gold) 20%,transparent);color:var(--ink);margin-left:5px}.modal{position:fixed;inset:0;z-index:50;background:#0008;display:none;align-items:flex-end}.modal.open{display:flex}.dialog{width:100%;max-height:94dvh;background:var(--card);border-radius:20px 20px 0 0;padding:14px;overflow:auto;color:var(--ink)}.dialog h2{margin:4px 0 12px}.row{display:flex;gap:8px;align-items:center}.row>*{flex:1}.field{width:100%;border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:10px;padding:10px;font-size:15px}.editor{width:100%;min-height:52dvh;resize:vertical;border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:12px;padding:12px;font:15px/1.55 "Roboto Mono","DejaVu Sans Mono",monospace;white-space:pre}.editorTools{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:8px 0}.editorTools button{background:var(--bg);color:var(--ink);border:1px solid var(--line);font-size:13px}.help{font-size:12px;color:var(--muted);line-height:1.4;margin:6px 2px 10px}.checklist{display:grid;gap:4px;margin:10px 0;max-height:45dvh;overflow:auto}.check{display:flex;gap:10px;align-items:flex-start;padding:9px;border:1px solid var(--line);border-radius:10px}.check input{margin-top:4px;transform:scale(1.2)}.check span{font-size:14px}.playlistItem{display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--line);padding:8px}.playlistItem button{background:transparent;color:var(--ink);border:1px solid var(--line);font-size:13px}.small{font-size:12px;color:var(--muted)}
@media(min-width:700px){header{padding-left:22px;padding-right:22px}main{padding:20px}.sheet{padding:24px 28px}footer{padding-left:20px;padding-right:20px}.modal{align-items:center;justify-content:center}.dialog{max-width:820px;border-radius:20px;max-height:90dvh}}
</style></head><body>
<div class="app"><header><div class="top"><button id="menu" aria-label="Menu">☰</button><div class="titlebox"><div id="songTitle"></div><div id="counter"></div></div><button id="minus">A−</button><button id="plus">A+</button><button id="edit">✎</button><button id="theme">◐</button></div></header><main id="stage"><div class="sheet"><pre id="lyrics"></pre><div class="hint">Deslize para os lados para trocar de música</div></div></main><footer><button id="prev" class="nav">‹ Anterior</button><select id="pageSelect"></select><button id="next" class="nav">Próxima ›</button></footer></div>
<div class="drawer" id="drawer"><div class="panel"><h2>Cânticos</h2><div class="toolbar"><butto